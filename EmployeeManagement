import java.util.*;
import java.util.stream.*;

class Employee {
    int id;
    String name;
    double salary;

    Employee(int id, String name, double salary) {
        this.id = id;
        this.name = name;
        this.salary = salary;
    }
}

public class EmployeeDemo {
    public static void main(String[] args) {

        List<Employee> list = new ArrayList<>();

        list.add(new Employee(1, "Rahul", 25000));
        list.add(new Employee(2, "Amit", 40000));
        list.add(new Employee(3, "Raj", 30000));

        // Display employees
        System.out.println("All Employees:");

        list.forEach(e ->
            System.out.println(e.id + " " + e.name + " " + e.salary)
        );

        // Filter employees
        System.out.println("\nSalary Above 30000:");

        list.stream()
            .filter(e -> e.salary > 30000)
            .forEach(e -> System.out.println(e.name));

        // Sort employees
        System.out.println("\nSorted Employees:");

        list.stream()
            .sorted((e1, e2) ->
                Double.compare(e1.salary, e2.salary))
            .forEach(e ->
                System.out.println(e.name + " " + e.salary));
    }
}
